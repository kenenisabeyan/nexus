# Copy to .env and fill in real values. Never commit the actual .env file.

# PostgreSQL connection string.
# Local dev default matches docker-compose.yml.
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/nexus_dev

# API server port.
PORT=4000

# Origin allowed to make credentialed requests to the API (CORS).
WEB_ORIGIN=http://localhost:5173

# development | staging | production — affects cookie Secure flag and error verbosity.
NODE_ENV=development

# Not yet used (no AI provider integration exists as of Milestone 0 — see
# ARCHITECTURE_STATUS.md, Section 6). Reserved for the Model Gateway work
# scheduled in Phase 4.
# AI_PROVIDER_API_KEY=
