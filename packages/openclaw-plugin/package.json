    "typebox": "^1.3.14"
  },
  "peerDependencies": {
    "openclaw": ">=2026.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.5.4",
    "openclaw": "^2026.7.1-2",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  },
  "openclaw": {
    "extensions": ["./src/index.ts"],
    "compat": {
      "pluginApi": ">=2026.7.0",
      "minGatewayVersion": "2026.7.0"
    },
    "build": {
      "openclawVersion": "2026.7.1-2",
      "pluginSdkVersion": "2026.7.1-2"
